# Proveedor LLM compatible con OpenAI. Sin esto, el motor corre offline
# con un fallback determinista (no necesitás key para probarlo).

# Cerebras (recomendado por velocidad/costo):
LLM_API_KEY=
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL=llama-3.3-70b

# También sirve cualquier otro compatible con OpenAI (OpenAI, OpenRouter, etc.):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct
